{
  "version": 1,

  "instructions": {
    "dir": "prose",
    "keys": ["entry", "specify", "prove", "emit", "state", "conc", "sec", "res", "decide", "browser", "update_docs"]
  },

  "fsm": {
    "graph": "fsm/graph.json",
    "predicates_reference": "fsm/predicates.md",
    "hooks_dir": "hooks"
  },

  "messages": {
    "gates_dir": "gates",
    "residual_dir": "residual"
  },

  "index": {
    "enabled": true,
    "wall_budget_ms": 45000,
    "max_chunks_per_file_per_pass": 64,
    "max_file_bytes": 262144
  },

  "memory": {
    "enabled": true,
    "embed_dim": 384,
    "namespaces": ["default", "codeinsight"],
    "recall_limit": 8,
    "pool_multiplier": 5,
    "pool_floor": 20,
    "default_k": 10,
    "tencentdb_backend": {
      "enabled": false,
      "data_dir": ".gm/tencentdb-memory",
      "vectors_db_dims": 768,
      "namespaces": []
    }
  },

  "memory_sync": {
    "embed_budget_ms": 1500,
    "total_budget_ms": 2000,
    "rekey_rows_deadline_ms": 1800,
    "shadow_abort_threshold": 5,
    "rekey_batch_max": 25,
    "rename_batch_chunk": 60
  },

  "embed": {
    "max_tokens": 512,
    "query_cache_cap_entries": 64,
    "query_cache_ttl_ms": 600000,
    "max_subbatch_items": 32,
    "max_subbatch_items_times_max_len_budget": 16384,
    "plain_cache_max_text": 4096
  },

  "scoring": {
    "bm25_k1": 1.2,
    "bm25_b": 0.75,
    "fusion_rrf_k": 60.0,
    "fusion_identifier_boost": 2.0,
    "fusion_vector_list_weight": 1.0,
    "recency_floor": 0.4,
    "cos_floor": 0.0,
    "dedup_jaccard_threshold": 0.7,
    "half_life_ms": 2592000000
  },

  "rssearch": {
    "table": "rssearch_vectors",
    "index": "rssearch_vectors_vec",
    "migrate_budget_ms": 2000,
    "migrate_reported_failures": 5
  },
  "git_commits": {
    "table": "git_commit_vectors",
    "index": "git_commit_vectors_vec",
    "embed_budget_ms": 30000,
    "min_embeds_per_pass": 8,
    "diff_char_cap": 4000,
    "log_window": 500
  },
  "code_chunks": { "table": "code_chunks", "index": "code_chunks_vec" },

  "code_index": {
    "prune_enumeration_cap": 20000
  },

  "pipeline": {
    "ttl_ms": 120000,
    "summarize_threshold": 2048,
    "max_result_bytes": 4096,
    "max_attempts": 2
  },

  "instruction_payload": {
    "ready_wave_limit": 3,
    "instruction_recall_hits": 5,
    "transition_recall_hits": 3,
    "prompt_excerpt_chars": 400,
    "max_marker_age_ms": 21600000,
    "orient_noun_limit": 5,
    "extra_orient_stopwords": []
  },

  "browser_witness": {
    "extra_always_browser_extensions": [],
    "extra_conditional_extensions": [],
    "extra_dir_prefixes": []
  },

  "discipline_note": {
    "max_name_len": 64,
    "max_text_len": 200,
    "active_policies_instruction_limit": 50
  },

  "claim_audit": {
    "extra_shipped_claim_markers": [],
    "extra_scan_paths": []
  },

  "cache": {
    "enabled": true,
    "max_entries_per_namespace": 5000,
    "max_bytes_per_namespace": 33554432,
    "default_ttl_ms": null
  },

  "sync": {
    "debounce_ms": 300000,
    "shallow": true
  }
}
